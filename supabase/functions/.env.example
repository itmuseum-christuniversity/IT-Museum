# Secrets for the Edge Functions. Set them with:
#   supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by the platform.)

# Firebase project whose ID tokens staff use to sign in.
FIREBASE_PROJECT_ID=
# Comma-separated list of site origins allowed to call the functions.
ALLOWED_ORIGINS=http://localhost:5173
# Public site URL used in contributor emails.
PUBLIC_SITE_URL=
# Server-side email delivery (EmailJS REST API; private key stays server-side).
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Shared secret a scheduler sends as x-cron-secret to retry notifications.
NOTIFY_CRON_SECRET=
# Abuse limits (see README → "Abuse limits"). Long random strings, e.g. `openssl rand -base64 32`.
# Secret for HMAC-ing client IPs / submitter emails before they are counted.
# If unset, a key derived from the service role key is used.
RATE_LIMIT_SALT=
# Secret for deriving a submission's access key from its idempotency key, so a
# retried submission (lost response) can show the same key again. If unset, a
# key derived from the service role key is used. Rotating it only stops that
# recovery for earlier attempts.
ACCESS_KEY_SECRET=
