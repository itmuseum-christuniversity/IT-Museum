# ---------------------------------------------------------------------------
# Frontend (Vite) — these values are bundled into the public JavaScript.
# Only put *public* identifiers here. Never put a service-role key or any
# private signing secret in a VITE_ variable.
# ---------------------------------------------------------------------------

# Supabase project URL and the public "anon" key (Project settings → API).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: base URL for Edge Functions. Defaults to $VITE_SUPABASE_URL/functions/v1
VITE_FUNCTIONS_URL=

# Firebase web app config (Project settings → General → Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — kept for reference; this app does not initialise Analytics.
VITE_FIREBASE_MEASUREMENT_ID=

# Optional public site URL used for canonical links and email links.
VITE_SITE_URL=
