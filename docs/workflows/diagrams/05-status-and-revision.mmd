flowchart TB
    S(["Contributor opens /submission/status"]):::start --> IN["Enter reference + access key<br/>reference can be pre-filled from the link<br/>the key is never put in the web address"]:::blue
    IN --> CHK{{"Server compares the key's hash<br/>in constant time"}}:::amber
    CHK -->|"No match or unknown reference"| ERR["Same generic error for both cases<br/>nothing reveals whether the reference exists"]:::red --> IN
    CHK -->|"Match"| VIEW["Safe status view<br/>reference, title, submitted date<br/>friendly status label and description<br/>history of contributor-visible steps only<br/>never internal notes or reviewer names"]:::green
    VIEW --> WHICH{{"Which status?"}}:::amber
    WHICH -->|"Received, In review, Final approval"| WAIT["Nothing to do - the panels are working<br/>In review shows stage 2, 3 or 4 of 5"]:::grey
    WHICH -->|"Published"| PUB["Read the published article link"]:::green
    WHICH -->|"Not accepted"| REJ["Reviewer's reason is shown<br/>no resubmission on this reference"]:::red
    WHICH -->|"Withdrawn from archive"| WD["Notice that it is not in the public archive"]:::grey
    WHICH -->|"Changes requested"| CR["Reviewer's note is shown<br/>Send your revision form appears"]:::gold
    CR --> F["What did you change? 10+ characters<br/>Optional new document link<br/>Optional replacement similarity and AI reports"]:::blue
    F --> FV{{"Valid?"}}:::amber
    FV -->|"No"| FE["Field errors, answers kept"]:::red --> F
    FV -->|"Yes, Send revision"| RS["Server replaces only what was sent<br/>status goes back to the stage that asked for changes<br/>one audit event with the contributor's note<br/>Revision received email queued"]:::green
    RS --> VIEW
    LEG["Old submissions made before October 2026 have no access key<br/>the museum answers by email"]:::grey -.-> IN

