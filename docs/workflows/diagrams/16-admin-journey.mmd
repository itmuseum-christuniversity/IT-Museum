flowchart TB
    S(["Admin opens /admin"]):::start --> G{{"Signed in and an<br/>active admin record?"}}:::amber
    G -->|"No"| L["Sign-in form or No access screen<br/>see the staff access workflow"]:::red --> G
    G -->|"Yes"| OV
    OV["Overview<br/>counts for every stage, your two queues highlighted<br/>Needs attention: waiting over 7 days or assigned to you<br/>Recent activity: last 15 audit events"]:::ink
    OV --> NAVQ["Left menu"]:::grey
    NAVQ --> INB["Inbox<br/>search by title, author, reference<br/>filter by stage, assignee, waiting time, dates<br/>oldest first"]:::blue
    NAVQ --> ARC["Archive<br/>Published, Unpublished, Rejected, Changes requested"]:::blue
    NAVQ --> STF["Staff and roles"]:::blue
    NAVQ --> PUBS["View public site"]:::grey
    INB --> WS["Article workspace<br/>manuscript and reports, details, notes, activity log<br/>decision panel, assignment"]:::blue
    ARC --> WS
    WS --> ST{{"Article status"}}:::amber
    ST -->|"SUBMITTED"| INT["Intake triage<br/>approve, request changes or reject"]:::gold
    ST -->|"FINAL_APPROVAL"| FIN["Prepare publication<br/>PDF, public details, checklist, publish"]:::gold
    ST -->|"IT, TECH or LIT review"| MON["Monitor: read, add notes, assign a reviewer<br/>the stage owner makes the decision"]:::blue
    ST -->|"PUBLISHED"| UNP["Unpublish with a reason"]:::red
    ST -->|"UNPUBLISHED"| REP["Replace PDF or details, republish"]:::green
    ST -->|"REJECTED"| REO["Reopen with a reason"]:::amber
    ST -->|"CHANGES_REQUESTED"| WAIT["Read only - waiting for the contributor"]:::grey
    INT --> BACK["Back to the Inbox or Overview"]:::grey
    FIN --> BACK
    MON --> BACK
    UNP --> BACK
    REP --> BACK
    REO --> BACK
    WAIT --> BACK
    BACK --> OV
    STF --> SO["Sign out any time from the top bar"]:::grey

