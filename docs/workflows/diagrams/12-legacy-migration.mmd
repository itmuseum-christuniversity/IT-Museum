flowchart LR
    subgraph OLD["Old status in the database"]
        direction TB
        o1["SUBMITTED"]
        o2["ADMIN_APPROVED"]
        o3["IT_APPROVED"]
        o4["TECH_APPROVED"]
        o5["LIT_APPROVED"]
        o6["PUBLISHED"]
