flowchart TB
    A(["IT, Technical or Literature reviewer signs in"]):::start --> OV["Overview<br/>count for their own stage only<br/>Needs attention: waiting over 7 days or assigned to them"]:::blue
    OV --> Q["My queue<br/>only articles in their stage<br/>oldest first, with how long each has waited"]:::blue
    Q --> O["Open an article"]:::blue
    O --> R["Stage checklist as a guide<br/>IT: relevant to IT history in India, accurate and dated, sources cited<br/>Technical: correct descriptions, accurate terms, supported figures and data<br/>Literature: clear structure, complete citations, follows the template"]:::gold
    R --> G["Read the Google Doc and the private reports<br/>comment directly in the Google Doc<br/>add an internal note in the portal"]:::blue
    G --> L{{"Literature reviewer?"}}:::amber
    L -->|"Yes"| T["Suggest archive tags<br/>saved for the admin to review"]:::gold --> D
    L -->|"No"| D
    D{{"Decision"}}:::amber
    D -->|"Approve"| A1["Moves to the next stage"]:::green
    D -->|"Request changes + reason"| A2["Contributor emailed and may revise<br/>comes back to this same stage"]:::amber
    D -->|"Reject + reason"| A3["Contributor emailed, review ends"]:::red
    A1 --> OUT["Confirmation toast, back to My queue<br/>the article has left this queue"]:::grey
    A2 --> OUT
    A3 --> OUT
    O -.->|"article in another stage"| NF["Article not found in your queues"]:::red

    classDef start fill:#10244d,stroke:#10244d,color:#ffffff
    classDef blue fill:#e8eef9,stroke:#234a9c,color:#0b1a3a
    classDef gold fill:#f6ecd2,stroke:#a8832b,color:#3d2d06
    classDef red fill:#fbe4e4,stroke:#b3261e,color:#5c0f0b
    classDef green fill:#e3f3e8,stroke:#2f7d4a,color:#0f3a1f
    classDef amber fill:#fff1d6,stroke:#c77c00,color:#4a2c00
    classDef ink fill:#10244d,stroke:#10244d,color:#ffffff
    classDef grey fill:#f2eee6,stroke:#8b857a,color:#2b2a27
