    classDef red fill:#fbe4e4,stroke:#b3261e,color:#5c0f0b
    classDef green fill:#e3f3e8,stroke:#2f7d4a,color:#0f3a1f
    classDef amber fill:#fff1d6,stroke:#c77c00,color:#4a2c00
    classDef ink fill:#10244d,stroke:#10244d,color:#ffffff
    classDef grey fill:#f2eee6,stroke:#8b857a,color:#2b2a27
