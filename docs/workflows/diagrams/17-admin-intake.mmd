flowchart TB
    A(["New article waits in SUBMITTED"]):::start --> OV["Appears in the admin Inbox and on Overview<br/>Your queue: Admin intake"]:::blue
    OV --> OPEN["Open the article workspace"]:::blue
    OPEN --> CH["Intake guide - a reminder, not saved<br/>1 Manuscript link opens and reviewers can comment<br/>2 Both reports are present and readable<br/>3 Similarity and AI levels are within guidance<br/>4 Author names, emails and designations are complete<br/>5 The topic fits the museum's scope"]:::gold
    CH --> AS{{"Assign someone first?"}}:::amber
    AS -->|"Yes"| AS1["Choose an active staff member<br/>for this stage's role, saved in the log"]:::blue --> DEC
    AS -->|"No"| DEC
    DEC{{"Decision"}}:::amber
    DEC -->|"Approve"| OK["Confirm<br/>status IT_REVIEW<br/>reaches the IT reviewer's queue"]:::green
    DEC -->|"Request changes<br/>reason 10+ characters"| RC["Confirm<br/>status CHANGES_REQUESTED, will return to SUBMITTED<br/>contributor emailed with the reason"]:::amber
    DEC -->|"Reject<br/>reason 10+ characters"| RJ["Confirm<br/>status REJECTED at SUBMITTED<br/>contributor emailed with the reason"]:::red
    OK --> LOG["Audit log records who, when, from, to, and the reason"]:::grey
    RC --> LOG
    RJ --> LOG
    OPEN -.->|"any time"| NOTE["Add an internal note"]:::grey
    DEC -.->|"article changed in another session"| CF["Conflict message and automatic reload"]:::red

